[Unit]
Description=Nugget SMP website and account API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nugget-web
Group=nugget-web
WorkingDirectory=/opt/nugget-website
Environment=NODE_ENV=production
EnvironmentFile=/etc/nugget-website.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nugget-website/data
UMask=0077

[Install]
WantedBy=multi-user.target
